---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada — Superheroes"
  description="Esa página no existe."
  path="/404"
  ogImage="fbprofile.png"
  twitterImage="twprofile.jpg"
>
  <section class="albumSingle padding background-properties">
    <div class="container">
      <div class="sectionTitle paddingBottom">
        <span class="heading-t3"></span>
        <h2>No encontramos esa página</h2>
        <span class="heading-b3"></span>
      </div>
      <div class="row">
        <div class="col-sm-12" style="text-align:center;">
          <p style="font-size:1.6rem; line-height:2.4rem;">
            Puede que el link esté roto o que la página se haya mudado.
          </p>
          <p style="font-size:1.6rem; line-height:2.4rem;">
            <a href="/">Volver al inicio</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
