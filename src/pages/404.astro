---
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
---

<Base
  title="Página no encontrada — Superheroes"
  description="Esa página no existe."
  path="/404"
  ogImage="fbprofile.png"
  twitterImage="twprofile.jpg"
>
  <section class="albumSingle padding background-properties">
    <div class="container">
      <Titulo>No encontramos esa página</Titulo>
      <article class="nota">
        <span class="nota-cinta" aria-hidden="true"></span>
        <p>Puede que el link esté roto o que la página se haya mudado.</p>
        <p><a href="/">Volver al inicio</a></p>
      </article>
    </div>
  </section>
</Base>
