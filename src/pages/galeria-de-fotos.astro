---
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
import { GALLERIES } from '../data/pages';
---

<Base
  title="Fotos — Superheroes"
  description="Fotos de Superhéroes en vivo en The Roxy el 8 de julio de 2007"
  ogTitle="Superhéroes - Galería de Fotos"
  path="/galeria-de-fotos"
  ogImage="fbprofile.png"
  twitterImage="twprofile.jpg"
>
  <!-- =============== INICIO GALERIAS ================ -->
  <section class="albumSingle background-properties" style="padding:12rem 7rem 7rem;">
    <div class="container">
      {
        GALLERIES.map((gallery) => (
          <>
            <Titulo>{gallery.heading}</Titulo>
            <div class="row paddingBottom">
              <div class="col-sm-12">
                <div
                  id={gallery.containerId}
                  class="juicebox-gallery"
                  data-config={gallery.configUrl}
                  style="margin: auto;"
                />
              </div>
            </div>
          </>
        ))
      }
    </div>
  </section>
  <!-- =============== FIN GALERIAS ================ -->

  <script>
    import '../scripts/galleries';
  </script>
</Base>
