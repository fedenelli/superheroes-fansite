---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.astro';
import { SITE } from '../data/site';

export interface Props {
  /** <title> contents. */
  title: string;
  /** meta description + twitter:description. */
  description: string;
  /** og:title. Falls back to the page title. */
  ogTitle?: string;
  /**
   * twitter:title. Defaults to ogTitle — but several legacy pages deliberately
   * differ between the two, so it is settable.
   */
  twitterTitle?: string;
  /** twitter:description. Defaults to `description`, which again some pages diverge from. */
  twitterDescription?: string;
  /** Path this page canonically lives at, e.g. '/album-verde' or ''. */
  path?: string;
  /** Filenames inside /assets/og_img/. Omitted on pages that never had a card image. */
  ogImage?: string;
  twitterImage?: string;
  /**
   * 'home' reproduces the wider chrome used by / and /discografia
   * (4rem logo, 4/4/4 footer, centred social icons); 'inner' is what every
   * other page uses today (3.5rem logo, 5/3/4 footer).
   */
  variant?: 'home' | 'inner';
}

const {
  title,
  description,
  ogTitle = title,
  twitterTitle = ogTitle,
  twitterDescription = description,
  path = '',
  ogImage,
  twitterImage,
  variant = 'inner',
} = Astro.props;

const isHome = variant === 'home';
const canonical = `${SITE.origin}${path}`;
const logoStyle = isHome
  ? "font-family:'Conv_BebasNeue Regular', Helvetica, Arial, sans-serif; font-weight:bold; color:#FFF; font-size:4rem;"
  : "font-family:'Conv_BebasNeue Regular'; font-weight:bold; color:#FFF; font-size:3.5rem;";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="HandheldFriendly" content="true" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/assets/img/content/icon.png" />

    <!-- ========== ESTILOS CSS ========== -->
    <link rel="stylesheet" href="/assets/css/master.css" />
    {isHome && <style>{"body{font-family:'Conv_BebasNeue Regular';}"}</style>}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    {twitterImage && <meta name="twitter:image" content={`${SITE.origin}/assets/og_img/${twitterImage}`} />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={`${SITE.origin}/assets/og_img/${ogImage}`} />}

    <ClientRouter />
  </head>

  <body>
    <!-- Google Tag Manager -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-N3SK6W');
    </script>
    <!-- End Google Tag Manager -->

    <div class="page-loader">
      <div class="vertical-align align-center">
        <img src="/assets/loader/loader.gif" alt="Cargando..." class="loader-img" />
      </div>
    </div>

    <Player />

    <!-- =============== INICIO TOP HEADER ================ -->
    <div class="topHeader">
      <div class="header">
        <div class="rightTopHeader">
          <!-- Open Menu Button -->
          <a class="open-menu">
            <span class="span-1"></span>
            <span class="span-2"></span>
            <span class="span-3"></span>
          </a>
        </div>
      </div>
      <!-- FIN header -->

      <div class="menu-fixed-container">
        <nav>
          <div class="x-filter">
            <span></span>
            <span></span>
          </div>
          <div style="width:80%; max-width:600px; margin:auto; padding-top: 20px;">
            <h3>Gracias.</h3>
            <br />
            <p style="text-align:justify; font-size:1.5rem; line-height:2rem;">
              Superhéroes fue la banda que escuché durante mi adolescencia, que tal vez no sirvió
              para desarrollar mi oído musical pero sí me hizo compartir grandes momentos con mis
              amigos. Por eso le estoy agradecido, y por eso esta web me pareció una forma de
              reconocerle algo a un grupo de personas que me regaló muchas horas de diversión.
            </p>
            <br />
            <p style="text-align:justify; font-size:1.5rem; line-height:2rem;">
              Ojalá lo disfruten tanto como yo.
            </p>
            <br />
            <p style="text-align:right; font-weight:bold; font-size:1.5rem; line-height:2rem;">
              Fede.
            </p>
          </div>
        </nav>
      </div>

      <!-- =============== SUPERHEROES LOGO ================ -->
      <div class="logo-container-top">
        <a href="/" style="text-decoration:none;"><span style={logoStyle}>SUPERHEROES</span></a>
      </div>
    </div>
    <!-- =============== FIN TOP HEADER ================ -->

    <slot />

    <!-- =============== INICIO FOOTER ================ -->
    <section style="background-color:#eeeeee;">
      <div class="footer footerPadding">
        <div class="container">
          <div class="row">
            <div class={isHome ? 'col-sm-4' : 'col-sm-5'}>
              <div class="copyFooter">
                <a href={SITE.authorUrl} target="_blank"
                  >Hecho por Fede Nelli en homenaje a Superhéroes</a
                >
              </div>
            </div>
            <div class={isHome ? 'col-sm-4' : 'col-sm-3'}>
              <nav class="social-icons">
                <ul class="clearfix" style={isHome ? 'text-align:center;' : undefined}>
                  <li>
                    <a href="https://www.facebook.com/estoyout/" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-facebook"></i><span></span></a
                    >
                  </li>
                  <li>
                    <a href="https://twitter.com/superheroestw" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-twitter"></i><span></span></a
                    >
                  </li>
                  <li>
                    <a href="https://superheroes.bandcamp.com/" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-music"></i><span></span></a
                    >
                  </li>
                  <li>
                    <a href="https://www.youtube.com/user/iwantyouaround" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-youtube-play"></i><span></span></a
                    >
                  </li>
                </ul>
              </nav>
            </div>
            <div class="col-sm-4">
              <div class="goTop back-to-top" id="back-to-top">
                <i class="fa fa-angle-up"></i>
                <a href="#">Volver Arriba</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- =============== FIN FOOTER ================ -->

    <script>
      import '../scripts/ui';
      import '../scripts/player';
    </script>
  </body>
</html>
