---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Player from '../components/Player.astro';
import { SITE } from '../data/site';
import '../styles/papel.css';

export interface Props {
  /** <title> contents. */
  title: string;
  /** meta description, og:description and twitter:description. */
  description: string;
  /** og:title and twitter:title. Falls back to the page title. */
  ogTitle?: string;
  /** Path this page canonically lives at, e.g. '/album-verde' or ''. */
  path?: string;
  /**
   * Filenames inside /assets/og_img/, or a root-relative path (e.g. a built
   * image under /_astro/). Omitted on pages that never had a card image.
   */
  ogImage?: string;
  twitterImage?: string;
  /**
   * 'home' reproduces the wider chrome used by / and /discografia
   * (4rem logo, 4/4/4 footer, centred social icons); 'inner' is what every
   * other page uses today (3.5rem logo, 5/3/4 footer).
   */
  variant?: 'home' | 'inner';
  /** Header starts transparent over a full-bleed first section; see Header.astro. */
  overlayHeader?: boolean;
  /** og:type — 'music.album' on release pages. */
  ogType?: string;
  /** Keeps the page out of search results; only the 404 uses it. */
  noindex?: boolean;
  /** schema.org objects printed as JSON-LD, so search engines know what the page is about. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle = title,
  path = '',
  ogImage,
  twitterImage,
  variant = 'inner',
  overlayHeader = false,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const isHome = variant === 'home';
const canonical = `${SITE.origin}${path || '/'}`;
// `</` inside a string would close the <script> early.
const ldJson = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const cardUrl = (file: string) => `${SITE.origin}${file.startsWith('/') ? file : `/assets/og_img/${file}`}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="HandheldFriendly" content="true" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/assets/img/content/icon.png" />

    <!-- ========== ESTILOS CSS ========== -->
    <link rel="stylesheet" href="/assets/css/master.css" />
    <!-- Courier Prime: the label-maker tape on every title. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap" />
    <slot name="head" />
    {isHome && <style>{"body{font-family:'Conv_BebasNeue Regular';}"}</style>}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    {twitterImage && <meta name="twitter:image" content={cardUrl(twitterImage)} />}
    <meta property="og:site_name" content={SITE.artist} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={cardUrl(ogImage)} />}
    {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}

    <ClientRouter />
  </head>

  <body>
    <!-- Google Tag Manager -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-N3SK6W');
    </script>
    <!-- End Google Tag Manager -->

    <div class="page-loader">
      <div class="vertical-align align-center">
        <img src="/assets/loader/loader.gif" alt="Cargando..." class="loader-img" />
      </div>
    </div>

    <Player />

    <Header path={path} variant={variant} overlay={overlayHeader} />

    <slot />

    <!-- =============== INICIO FOOTER ================ -->
    <section class="footer-papel">
      <div class="footer footerPadding">
        <div class="container">
          <div class="row">
            <div class={isHome ? 'col-sm-4' : 'col-sm-5'}>
              <div class="copyFooter">
                <a href={SITE.authorUrl} target="_blank"
                  >Hecho por Fede Nelli en homenaje a Superhéroes</a
                >
              </div>
            </div>
            <div class={isHome ? 'col-sm-4' : 'col-sm-3'}>
              <nav class="social-icons">
                <ul class="clearfix" style={isHome ? 'text-align:center;' : undefined}>
                  <li>
                    <a href="https://www.facebook.com/estoyout/" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-facebook"></i><span></span></a
                    >
                  </li>
                  <li>
                    <a href="https://twitter.com/superheroestw" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-twitter"></i><span></span></a
                    >
                  </li>
                  <li>
                    <a href="https://superheroes.bandcamp.com/" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-music"></i><span></span></a
                    >
                  </li>
                  <li>
                    <a href="https://www.youtube.com/user/iwantyouaround" class="icon-button shopIcon" target="_blank"
                      ><i class="fa fa-youtube-play"></i><span></span></a
                    >
                  </li>
                </ul>
              </nav>
            </div>
            <div class="col-sm-4">
              <div class="goTop back-to-top" id="back-to-top">
                <i class="fa fa-angle-up"></i>
                <a href="#">Volver Arriba</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- =============== FIN FOOTER ================ -->

    <script>
      import '../scripts/ui';
      import '../scripts/player';
    </script>
  </body>
</html>
