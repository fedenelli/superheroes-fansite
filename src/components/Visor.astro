---
/**
 * The photo viewer: a native <dialog>, driven by src/scripts/visor.ts.
 *
 * The filmstrip at the bottom is the viewer's source of truth — each button
 * carries its photo's URLs — and `a.shf-abrir[data-foto=n]` in the page opens
 * it at photo n. Without JS those links still open the original file.
 */
import type { Version } from '../data/fotos';

interface Props {
  titulo: string;
  fotos: (Version & { alt: string })[];
}

const { titulo, fotos } = Astro.props;
---

<dialog class="shv" aria-label={`Fotos: ${titulo}`}>
  <div class="shv-barra">
    <p class="shv-cuenta"><span data-shv="numero">1</span> / {fotos.length}</p>
    <p class="shv-titulo">{titulo}</p>
    <a class="shv-original" data-shv="original" href={fotos[0]?.original} target="_blank" rel="noopener">
      Ver original <span aria-hidden="true">↗</span>
    </a>
    <button type="button" class="shv-boton shv-cerrar" data-shv="cerrar" aria-label="Cerrar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
  </div>

  <div class="shv-escenario" data-shv="escenario">
    <img class="shv-img" data-shv="img" alt="" />
    <button type="button" class="shv-boton shv-paso shv-paso--ant" data-shv="anterior" aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
    </button>
    <button type="button" class="shv-boton shv-paso shv-paso--sig" data-shv="siguiente" aria-label="Foto siguiente">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
    </button>
  </div>

  <ol class="shv-tira" data-shv="tira">
    {
      fotos.map((foto, i) => (
        <li>
          <button
            type="button"
            class="shv-mini"
            data-mini={foto.mini}
            data-grande={foto.grande}
            data-original={foto.original}
            data-alt={foto.alt}
            aria-label={`Foto ${i + 1}`}>
            <img src={foto.mini} alt="" width={foto.ancho} height={foto.alto} loading="lazy" decoding="async" />
          </button>
        </li>
      ))
    }
  </ol>
</dialog>

<script>
  import '../scripts/visor';
</script>

<style is:global>
  .shv {
    --shv-fondo: #0e0e0e;
    --shv-tinta: #f4f4f4;
    --shv-ambar: #f0b23c;
    width: 100vw;
    width: 100dvw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--shv-fondo);
    color: var(--shv-tinta);
    overflow: hidden;
  }
  .shv[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: shv-entrar 0.2s ease-out;
  }
  .shv::backdrop {
    background: var(--shv-fondo);
  }
  @keyframes shv-entrar {
    from {
      opacity: 0;
    }
  }

  /* ---- top bar ---- */
  .shv-barra {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1rem 1rem 1rem 2.4rem;
    font: 700 1.4rem/1 var(--dymo-font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  html body .shv-barra p {
    margin: 0;
    font: inherit;
    color: inherit;
  }
  html body .shv-barra .shv-cuenta {
    font-variant-numeric: tabular-nums;
    color: var(--shv-ambar);
  }
  .shv-titulo {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.7;
  }
  html body a.shv-original {
    color: var(--shv-tinta);
    font: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  html body a.shv-original:hover,
  html body a.shv-original:focus-visible {
    color: var(--shv-ambar);
  }

  .shv-boton {
    display: grid;
    place-items: center;
    width: 4.8rem;
    height: 4.8rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--shv-tinta);
    cursor: pointer;
    transition: background 0.15s;
  }
  .shv-boton svg {
    width: 2.4rem;
    height: 2.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .shv-boton:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .shv-boton:focus-visible,
  .shv-mini:focus-visible {
    outline: 2px solid var(--shv-ambar);
    outline-offset: 2px;
  }

  /* ---- stage ---- */
  .shv-escenario {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    overflow: hidden;
    padding: 0 7rem;
    /* Swipes are handled in visor.ts. */
    touch-action: none;
    user-select: none;
  }
  /* Fills the stage and letterboxes itself; a max-height inside the grid cell wouldn't resolve. */
  .shv-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s;
    -webkit-user-drag: none;
  }
  /* While the full-size copy downloads, the (already cached) thumbnail stands in. */
  .shv-escenario.is-cargando .shv-img {
    filter: blur(6px);
  }
  .shv-escenario.is-arrastrando .shv-img {
    transition: none;
  }
  .shv-paso {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 5.6rem;
    height: 5.6rem;
    background: rgba(0, 0, 0, 0.35);
  }
  .shv-paso--ant {
    left: 1rem;
  }
  .shv-paso--sig {
    right: 1rem;
  }
  .shv-paso:disabled {
    opacity: 0.2;
    cursor: default;
  }

  /* ---- filmstrip ---- */
  .shv-tira {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    padding: 1.2rem 1.6rem 1.6rem;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: thin;
    scrollbar-color: #444 transparent;
  }
  .shv-tira li {
    flex: none;
  }
  .shv-mini {
    display: block;
    height: 6.4rem;
    padding: 0;
    border: 0;
    background: #222;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  .shv-mini img {
    display: block;
    width: auto;
    height: 100%;
  }
  .shv-mini:hover {
    opacity: 0.8;
  }
  .shv-mini[aria-current='true'] {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--shv-ambar);
  }

  @media (max-width: 767px) {
    .shv-barra {
      gap: 1.2rem;
      padding-left: 1.6rem;
      font-size: 1.2rem;
    }
    .shv-titulo {
      display: none;
    }
    .shv-original {
      margin-left: auto;
    }
    /* Phones swipe; the arrows would only cover the photo. */
    .shv-escenario {
      padding: 0;
    }
    .shv-paso {
      display: none;
    }
    .shv-mini {
      height: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shv[open] {
      animation: none;
    }
  }
</style>
